on property:sys.boot_completed=1
    chown system system /sys/class/devfreq/ff400000.gpu/governor
    chown system system /sys/class/devfreq/ff400000.gpu/min_freq
    chown system system /sys/class/devfreq/ff400000.gpu/max_freq
    start sshd

on early-boot
    # Update dm-verity state and set partition.*.verified properties
    verity_update_state

on property:rw.logger=1
    start logger_kernel
    start logger_android
    start logger_radio

on property:rw.logger=0
    stop logger_kernel
    stop logger_android
    stop logger_radio

on boot
    chown system system /sys/class/thermal/thermal_zone0/policy
    chown system system /sys/class/thermal/thermal_zone1/policy
    chown system system /sys/class/thermal/thermal_zone2/policy
    
    # update cpusets feature nodes for rk3326 tablet
    write /dev/cpuset/foreground/cpus 0-3
    write /dev/cpuset/foreground/boost/cpus 0-3
    write /dev/cpuset/background/cpus 0-2
    write /dev/cpuset/system-background/cpus 0-2
    write /dev/cpuset/top-app/cpus 0-3

    # reduce schedul time to improve io performance
    write /sys/kernel/debug/sched_features NO_ENERGY_AWARE

    write proc/sys/vm/dirty_background_ratio 1
    write proc/sys/vm/dirty_ratio 3
    #for root
    start rootservice

#add changed root by zhenhua begin 20190806
service rootservice /system/bin/rootsudaemon.sh
    user root
    group root
    disabled
    oneshot
    seclabel u:r:init:s0

#logger service: logger [kernel|android|radio] 
service logger_kernel /system/bin/logger.sh kernel
   user root
   group root
   disabled
   oneshot
   seclabel u:r:init:s0

service logger_android /system/bin/logger.sh android
   user root
   group root
   disabled
   oneshot
   seclabel u:r:init:s0

service logger_radio /system/bin/logger.sh radio
   user root
   group root
   disabled
   oneshot
   seclabel u:r:init:s0

service sshd /system/bin/start-ssh
    seclabel u:r:adbd:s0
    class main
    disabled
    oneshot

# add for 4G
service ril-daemon /vendor/bin/hw/rild -l /vendor/lib/libquectel-ril.so
    class main
    user root
    group radio vpn cache inet misc audio log readproc wakelock
    capabilities BLOCK_SUSPEND NET_ADMIN NET_RAW

on init
    # Increased power consumption and CPU in exchange for memory
    write /proc/sys/vm/swappiness 100
    write /sys/block/zram0/comp_algorithm lz4

    # Load persistent dm-verity state
    verity_load_state

    chown root root /sys/class/devfreq/dmc/system_status
    chmod 0666 /sys/class/devfreq/dmc/system_status
    chmod 0666 /dev/watchdog
    chmod 0666 /sys/class/graphics/fb0/blank
    #/dev/block/by-name/keypart
    chmod 0666 /dev/block/mmcblk1p17
    #/dev/block/by-name/STSN
    chmod 0666 /dev/block/mmcblk1p18

